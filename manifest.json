{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "1.0.0",
  "description": "__MSG_extDescription__",
  "default_locale": "zh_CN",
  "permissions": [
    "storage",
    "tabs",
    "activeTab",
    "scripting",
    "alarms",
    "webNavigation"
  ],
  "host_permissions": [
    "https://*.google.com/*",
    "https://*.google.co.jp/*",
    "https://*.google.co.uk/*",
    "https://*.google.de/*",
    "https://*.google.fr/*",
    "https://*.baidu.com/*",
    "https://*.bing.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "src/popup/index.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_title": "__MSG_extName__"
  }
}
